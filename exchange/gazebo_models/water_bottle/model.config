<?xml version="1.0"?>
<model>
  <name>water_bottle</name>
  <version>1.0</version>
  <sdf version="1.4">water_bottle.sdf</sdf>
  <description>
    Bottle of still water for the bar counter. Built the same way as
    pal_gazebo_worlds' sprite/cocacola models — a textured cylinder, NOT a mesh
    (those models are not meshes either). Same radius and height as sprite so
    the tuned grasp sequence in grasp_test.py works unchanged.
  </description>
</model>
