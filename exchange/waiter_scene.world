      <visual name="s"><pose>0 0 0.44 0 0 0</pose><geometry><box><size>0.42 0.42 0.05</size></box></geometry><material><ambient>0.34 0.28 0.20 1</ambient><diffuse>0.54 0.44 0.32 1</diffuse></material></visual>
